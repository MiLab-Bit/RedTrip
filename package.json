{
  "name": "redtrip",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @redtrip/web dev --host 127.0.0.1 --port 5173",
