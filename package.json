{
  "name": "redtrip",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "pnpm --filter @redtrip/web dev --host 127.0.0.1 --port 5173",
    "dev:web": "pnpm --filter @redtrip/web dev --host 127.0.0.1 --port 5173",
    "build": "pnpm --filter @redtrip/contracts build && pnpm --filter @redtrip/web build",
    "typecheck": "pnpm --filter @redtrip/contracts typecheck && pnpm --filter @redtrip/web typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript-eslint": "^8.12.0"
  }
}
