# RedTrip local env (copy to .env — never commit .env)

# Shanghai Library contest API key. Do not commit real value.
SLC_API_KEY=

# Optional: path to slc_mcp_server.py for mcp mode
# SLC_MCP_SERVER=

# Bypass local proxy for library / sou-yun hosts
NO_PROXY=*.library.sh.cn,library.sh.cn,data1.library.sh.cn,opendata.library.sh.cn,sou-yun.cn,api.sou-yun.cn

# Windows Python UTF-8
PYTHONUTF8=1

# Runtime data mode: snapshot | indexed | mcp
REDTRIP_MODE=indexed

# LLM (OpenAI-compatible): polish evidence-bound narrative only; Gate fail → template
# 已切换为微信 chatapi 网关 + GLM-5.2；下方为示例，复制为 .env 后填真实 KEY。
# LLM_API_BASE=https://chatapi.weixin.qq.com/openai/v1
# LLM_API_KEY=<见运维：微信 chatapi 网关密钥>
# LLM_MODEL=GLM-5.2
# LLM_TIMEOUT_S=900  # 长散文(~10000字)需放宽到 900s
LLM_API_BASE=
LLM_API_KEY=
LLM_MODEL=

# 长散文（路线零件）输出上限 token：端点默认 ~4096 token 会把 ~10000 字截短，
# 显式拉高；按模型实际输出上限调整（过大可能触发端点报错）。
REDTRIP_ESSAY_MAX_TOKENS=16000

# API
API_HOST=127.0.0.1
API_PORT=8799

# OSM: demo prefers corridor fixture; set 0 to force Overpass
# REDTRIP_OSM_PREFER_FIXTURE=1

# ---- auth-core 用户系统（独立仓库 ../auth-core，docker-compose 需要） ----
# 生产必须设置；缺失则 auth-core 启动失败（不会回退默认密钥）。
AUTH_JWT_SECRET=
# 可选：pg / 演示态
# AUTH_STORE=memory

# 说明：本文件同时被 docker-compose.yml 读取（compose 默认加载同目录 .env）。
# 复制为 .env 并填入真实值后：`docker compose up --build`。

