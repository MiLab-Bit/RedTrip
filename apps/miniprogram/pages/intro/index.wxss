.intro-page .book-frame {
  position: relative;
  margin-bottom: 36rpx;
  padding: 36rpx 28rpx 28rpx;
  background:
    linear-gradient(165deg, rgba(251, 248, 241, 0.95), transparent 42%),
    linear-gradient(180deg, var(--paper-bright), #f3ecdf);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  box-shadow: var(--shadow-soft);
  overflow: hidden;
}

.intro-page .book-frame::before {
  content: "";
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 12rpx;
  background: linear-gradient(
    180deg,
    rgba(51, 51, 58, 0.16),
    rgba(168, 50, 42, 0.2) 50%,
    rgba(51, 51, 58, 0.12)
  );
}

.intro-page .book-frame::after {
  content: "";
  position: absolute;
  right: 0;
  top: 10%;
  bottom: 10%;
  width: 8rpx;
  background: repeating-linear-gradient(
    to right,
    transparent 0 2rpx,
    rgba(124, 138, 141, 0.28) 2rpx 3rpx
  );
  opacity: 0.55;
  pointer-events: none;
}

.degrade-banner {
  position: relative;
  z-index: 1;
  margin-bottom: 28rpx;
  padding: 22rpx 24rpx;
  background: linear-gradient(180deg, #fbf3e4, #f6ebda);
  border: 1rpx solid #d9c49a;
  border-left: 6rpx solid #b0925e;
  border-radius: 4rpx;
}

.degrade-title {
  display: block;
  font-family: var(--font-display);
  font-weight: 400;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  color: #5a4a2e;
}

.degrade-line {
  display: block;
  font-size: 24rpx;
  color: #6b5a36;
  line-height: 1.55;
}

.degrade-expand {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8a6d3b;
  text-decoration: underline;
}

.hongyuan-line {
  position: relative;
  z-index: 1;
  margin: 24rpx 0;
  padding: 20rpx 8rpx;
  border-top: 1rpx dashed rgba(185, 130, 79, 0.45);
  border-bottom: 1rpx dashed rgba(185, 130, 79, 0.45);
  color: #8a6b3e;
  font-family: var(--font-display);
  font-style: italic;
  font-size: 28rpx;
  line-height: 1.65;
}

.cast-block,
.chapter-block {
  position: relative;
  z-index: 1;
  margin: 32rpx 0 8rpx;
}

.cast-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.cast-chip {
  padding: 12rpx 22rpx;
  border: 1rpx solid rgba(168, 50, 42, 0.38);
  background: linear-gradient(180deg, rgba(168, 50, 42, 0.12), rgba(168, 50, 42, 0.05));
  color: var(--seal);
  border-radius: 4rpx;
  font-family: var(--font-display);
  font-size: 26rpx;
  box-shadow: var(--shadow-chip);
}

.chapter-item {
  display: grid;
  grid-template-columns: auto 1fr auto;
  gap: 16rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx dotted rgba(51, 51, 58, 0.16);
}

.chapter-item:last-child {
  border-bottom: none;
}

.chapter-num {
  font-family: var(--font-display);
  font-size: 40rpx;
  color: var(--seal);
  line-height: 1.1;
  min-width: 48rpx;
}

.chapter-name {
  display: block;
  font-family: var(--font-display);
  font-size: 32rpx;
  color: var(--ink-deep);
  letter-spacing: 0.02em;
}

.chapter-hook {
  display: block;
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-top: 8rpx;
  line-height: 1.6;
}

.chapter-rel {
  display: block;
  font-size: 22rpx;
  color: var(--seal);
  margin-top: 8rpx;
  opacity: 0.9;
}

.chapter-min {
  font-size: 22rpx;
  color: var(--slate);
  letter-spacing: 0.06em;
  padding-top: 8rpx;
}

.intro-page .title,
.intro-page .lead,
.intro-page .kicker {
  position: relative;
  z-index: 1;
}
