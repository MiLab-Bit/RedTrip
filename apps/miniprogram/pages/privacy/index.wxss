.privacy-page {
  padding-bottom: 80rpx;
}

.privacy-page .title {
  font-family: var(--font-display);
  font-size: 44rpx;
  font-weight: 400;
  margin-bottom: 12rpx;
}

.privacy-page .meta {
  font-size: 22rpx;
  color: var(--slate);
  margin-bottom: 36rpx;
  letter-spacing: 0.06em;
}

.section {
  margin-bottom: 32rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx dotted rgba(51, 51, 58, 0.14);
}

.section:last-of-type {
  border-bottom: none;
}

.h {
  font-family: var(--font-display);
  font-size: 30rpx;
  font-weight: 400;
  color: var(--ink-deep);
  margin-bottom: 14rpx;
  letter-spacing: 0.04em;
}

.p,
.li {
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.8;
  margin-bottom: 10rpx;
}
