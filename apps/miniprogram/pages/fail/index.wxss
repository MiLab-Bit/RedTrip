.fail-page {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
}

.fail-page .panel {
  width: 100%;
}

.fail-page .msg {
  margin: 22rpx 0 26rpx;
  font-size: 28rpx;
  color: var(--ink-muted);
  line-height: 1.7;
}

.hints {
  margin-bottom: 32rpx;
  padding: 20rpx 22rpx;
  background: rgba(237, 228, 211, 0.4);
  border-radius: 4rpx;
  border: 1rpx solid var(--line);
}

.hint-item {
  display: block;
  font-size: 24rpx;
  color: var(--slate);
  margin-bottom: 10rpx;
  line-height: 1.5;
}

.hint-item:last-child {
  margin-bottom: 0;
}
