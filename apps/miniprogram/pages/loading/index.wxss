.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 100vh;
  padding-top: 48rpx;
}

.loading-card {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 36rpx 40rpx;
  background:
    linear-gradient(165deg, rgba(251, 248, 241, 0.96), transparent 45%),
    linear-gradient(180deg, var(--paper-bright), #f3ecdf);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  box-shadow: var(--shadow-soft);
  position: relative;
  overflow: hidden;
}

.loading-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(
    ellipse 70% 40% at 50% 0%,
    rgba(168, 50, 42, 0.07),
    transparent 65%
  );
  pointer-events: none;
}

.loading-hero {
  position: relative;
  z-index: 1;
  margin-bottom: 40rpx;
}

.brand-logo.large {
  width: 112rpx;
  height: 112rpx;
  margin-bottom: 16rpx;
}

.loading-brand {
  display: block;
  margin-bottom: 12rpx;
  font-size: 48rpx;
}

.loading-layer {
  display: block;
  font-size: 26rpx;
  letter-spacing: 0.28em;
  color: var(--seal);
  font-family: var(--font-display);
}

.progress-wrap {
  position: relative;
  z-index: 1;
  width: 100%;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.progress-track {
  flex: 1;
  height: 14rpx;
  border-radius: 999rpx;
  background: rgba(51, 51, 58, 0.08);
  overflow: hidden;
  box-shadow: inset 0 2rpx 4rpx rgba(51, 51, 58, 0.06);
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #c4704a, var(--seal));
  transition: width 0.35s ease;
  box-shadow: 0 0 12rpx rgba(168, 50, 42, 0.35);
}

.progress-pct {
  font-family: var(--font-display);
  font-size: 24rpx;
  color: var(--ink-muted);
  min-width: 72rpx;
}

.seal-track {
  position: relative;
  z-index: 1;
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 36rpx;
}

.seal-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}

.seal {
  width: 68rpx;
  height: 68rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 32rpx;
  color: rgba(168, 50, 42, 0.32);
  border: 2rpx dashed rgba(168, 50, 42, 0.28);
  border-radius: 4rpx;
  background: rgba(255, 252, 246, 0.5);
}

.seal.is-stamped {
  color: var(--seal);
  border-style: solid;
  border-color: rgba(168, 50, 42, 0.78);
  background: linear-gradient(160deg, rgba(168, 50, 42, 0.14), rgba(168, 50, 42, 0.05));
  box-shadow: inset 0 0 0 2rpx rgba(168, 50, 42, 0.1),
    0 4rpx 12rpx rgba(168, 50, 42, 0.12);
  transform: rotate(-4deg);
}

.seal-label {
  font-size: 20rpx;
  color: #aaa;
  letter-spacing: 0.14em;
}

.seal-slot.is-hit .seal-label {
  color: var(--seal);
}

.phase-line {
  position: relative;
  z-index: 1;
  font-family: var(--font-display);
  font-size: 32rpx;
  color: var(--ink-deep);
  margin-bottom: 16rpx;
  min-height: 48rpx;
  letter-spacing: 0.04em;
}

.tip-line {
  position: relative;
  z-index: 1;
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.65;
  min-height: 84rpx;
  padding: 0 8rpx;
}

.cancel-btn {
  margin-top: 40rpx;
  width: 240rpx;
}

.preview-entry {
  position: relative;
  z-index: 1;
  margin-top: 28rpx;
  width: 100%;
}

.loading-footer {
  width: 100%;
  max-width: 620rpx;
  margin-top: 24rpx;
}

.phase-line.mini {
  font-size: 24rpx;
  color: var(--ink-muted);
  margin-bottom: 16rpx;
}

.preview-sheet {
  width: 100%;
  max-width: 680rpx;
  padding: 32rpx 28rpx;
  background: linear-gradient(180deg, var(--paper-bright), #f3ecdf);
  border: 1rpx solid var(--line);
  border-radius: 4rpx;
  box-shadow: var(--shadow-soft);
  text-align: left;
}

.preview-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.preview-kicker {
  font-size: 22rpx;
  color: var(--ochre);
  letter-spacing: 0.1em;
}

.preview-back {
  font-size: 24rpx;
  color: var(--ink-muted);
  background: transparent;
  border: none;
  padding: 0;
}

.preview-title {
  font-family: var(--font-display);
  font-size: 36rpx;
  color: var(--ink-deep);
  margin-bottom: 12rpx;
}

.preview-channel {
  display: inline-block;
  font-size: 22rpx;
  color: var(--seal);
  border: 1rpx solid rgba(168, 50, 42, 0.35);
  padding: 4rpx 12rpx;
  margin-bottom: 20rpx;
}

.preview-body {
  margin-bottom: 24rpx;
}

.preview-para {
  font-family: var(--font-display);
  font-size: 30rpx;
  line-height: 2;
  color: var(--ink-deep);
  margin-bottom: 20rpx;
  text-align: justify;
}

.preview-nav {
  display: flex;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.preview-rail {
  white-space: nowrap;
  padding: 8rpx 0;
}
