.loading-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  min-height: 100vh;
}

.loading-hero {
  margin-bottom: 48rpx;
}

.brand-logo.large {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 24rpx;
}

.loading-layer {
  display: block;
  font-size: 28rpx;
  letter-spacing: 0.2em;
  color: var(--seal);
}

.progress-wrap {
  width: 100%;
  max-width: 560rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: rgba(51, 51, 58, 0.08);
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #c4704a, var(--seal));
  transition: width 0.35s ease;
}

.progress-pct {
  font-size: 24rpx;
  color: var(--ink-muted);
  min-width: 72rpx;
}

.seal-track {
  width: 100%;
  max-width: 560rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.seal-slot {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.seal {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: rgba(168, 50, 42, 0.35);
  border: 2rpx dashed rgba(168, 50, 42, 0.28);
  border-radius: 4rpx;
}

.seal.is-stamped {
  color: var(--seal);
  border-style: solid;
  border-color: rgba(168, 50, 42, 0.75);
  background: rgba(168, 50, 42, 0.08);
}

.seal-label {
  font-size: 20rpx;
  color: #aaa;
  letter-spacing: 0.14em;
}

.seal-slot.is-hit .seal-label {
  color: var(--seal);
}

.phase-line {
  font-size: 30rpx;
  color: var(--ink-deep);
  margin-bottom: 16rpx;
  min-height: 44rpx;
}

.tip-line {
  font-size: 26rpx;
  color: var(--ink-muted);
  line-height: 1.6;
  max-width: 560rpx;
  min-height: 80rpx;
  padding: 0 16rpx;
}

.cancel-btn {
  margin-top: 48rpx;
  width: 240rpx;
}
